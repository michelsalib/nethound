{
	"name": "@michelsalib/nethound",
	"version": "0.7.0",
	"description": "See which process listens on each port, which interfaces reach it, and how everything on your machine connects",
	"keywords": [
		"network",
		"ports",
		"netstat",
		"ss",
		"lsof",
		"interfaces",
		"docker",
		"routes",
		"linux",
		"macos",
		"windows"
	],
	"license": "MIT",
	"author": "Michel Salib",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/michelsalib/nethound.git"
	},
	"homepage": "https://github.com/michelsalib/nethound#readme",
	"bugs": "https://github.com/michelsalib/nethound/issues",
	"type": "module",
	"bin": {
		"nethound": "dist/nethound.js"
	},
	"files": [
		"dist/nethound.js",
		"dist/SHA256SUMS"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "bun src/cli.ts",
		"build": "bun build src/cli.ts --target=node --minify --outfile dist/nethound.js",
		"build:bin": "bun scripts/build-binaries.ts",
		"test": "bun test --timeout 30000",
		"typecheck": "tsc",
		"lint": "biome check",
		"prepublishOnly": "bun run typecheck && bun run lint && bun run build && bun test --timeout 30000"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.4",
		"typescript": "^7.0.2"
	}
}
